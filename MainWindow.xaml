<Window x:Class="Donutz_VR_HUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Donutz_VR_HUD"
        xmlns:models="clr-namespace:Donutz_VR_HUD.Models"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Title="Donutz VR HUD" Height="940" Width="960" MinHeight="960" MinWidth="900"
        Icon="pack://application:,,,/Assets/AppIcon.ico">
    <Window.Resources>
        <local:SourceTypeCheckedConverter x:Key="SourceTypeConverter"/>
        <local:SourceTypeVisibilityConverter x:Key="SourceTypeVisibilityConverter"/>
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <local:ActivePanelBorderBrushConverter x:Key="ActivePanelBorderBrushConverter"/>
        <local:HexColorToBrushConverter x:Key="HexColorToBrushConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            
        </Grid.RowDefinitions>

        <!-- Profile: save/load complete panel configurations, optionally
             tied to a specific simulation and/or car, with optional
             automatic loading when that simulation/car is detected. -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}"  BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">


            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.Header]}" FontWeight="Bold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="ProfilesComboBox" Grid.Column="0" Margin="0,0,8,0"
                              DisplayMemberPath="Name" SelectionChanged="ProfilesComboBox_SelectionChanged"/>
                    <Button Grid.Column="1" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.Load]}" Width="80" Margin="0,0,4,0" Click="LoadProfileButton_Click"/>
                    <Button Grid.Column="2" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.SaveAs]}" Width="120" Margin="0,0,4,0" Click="SaveProfileAsButton_Click"/>
                    <Button Grid.Column="3" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.Update]}" Width="100" Margin="0,0,4,0" Click="UpdateProfileButton_Click"/>
                    <Button Grid.Column="4" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.Delete]}" Width="80" Click="DeleteProfileButton_Click"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.Game]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="ProfileGameComboBox" Grid.Column="1" Margin="0,0,12,0" IsEditable="True"
                              ItemsSource="{Binding RunningProcessNames}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.Car]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="ProfileCarTextBox" Grid.Column="3" Margin="0,0,4,0"/>
                    <Button Grid.Column="4" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.TakeCarFromSimHub]}" Click="TakeCarFromSimHubButton_Click"/>
                    
                </Grid>
                <!-- Checkboxes and status text are split into two rows:
                     packing them into a single DockPanel left the
                     right-docked status text squeezed into a narrow
                     column once the (long) checkbox labels claimed most
                     of the width, causing it to wrap onto many lines and
                     blow up this section's height as soon as the
                     auto-profile timer populated it with a status
                     message. -->
                <!--<DockPanel LastChildFill="False">-->
                    
                    <CheckBox x:Name="AutoLoadProfilesCheckBox" DockPanel.Dock="Left" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.AutoLoad]}" Checked="AutoLoadProfilesCheckBox_Changed" Unchecked="AutoLoadProfilesCheckBox_Changed" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <CheckBox x:Name="AutoSaveProfileOnSimExitCheckBox" DockPanel.Dock="Left" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.AutoSaveOnExit]}" Checked="AutoSaveProfileOnSimExitCheckBox_Changed" Unchecked="AutoSaveProfileOnSimExitCheckBox_Changed" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <CheckBox x:Name="ProfileIsDefaultCheckBox" DockPanel.Dock="Left" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Profile.IsDefault]}" VerticalAlignment="Center"/>
                <!--</DockPanel>-->
                <TextBlock x:Name="ProfileStatusText" Margin="0,4,0,0" TextWrapping="Wrap" Text=""/>
            </StackPanel>
        </Border>




        <!--<Border Grid.Row="3" Grid.RowSpan="3" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="4" Margin="0,0,0,8" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="8">-->
        <Border Grid.Row="4" Grid.RowSpan="3" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="2" CornerRadius="4" Margin="0,0,0,8" Background="#3a3a32" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Panel list header + add button -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button x:Name="AddPanelButton" DockPanel.Dock="Right" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panels.Add]}" Click="AddPanelButton_Click"/>
            <CheckBox x:Name="EditModeToggleCheckBox" DockPanel.Dock="Right" Content="Edit Mode"
                      Checked="EditModeToggle_Changed" Unchecked="EditModeToggle_Changed" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="Bold"/>
            <Button x:Name="NativeLogToggleButton" DockPanel.Dock="Right" Width="32" Height="32" Padding="0" Margin="0,0,8,0"
                    ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[NativeLog.Header]}" Click="NativeLogToggleButton_Click">
                <ui:SymbolIcon Symbol="DocumentText24"/>
            </Button>
            <Button x:Name="SettingsToggleButton" DockPanel.Dock="Right" Width="32" Height="32" Padding="0" Margin="0,0,8,0"
                    ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Header]}" Click="SettingsToggleButton_Click">
                <ui:SymbolIcon Symbol="Settings24"/>
            </Button>
            <Button x:Name="AboutButton" DockPanel.Dock="Right" Width="32" Height="32" Padding="0" Margin="0,0,16,0"
                    ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[About.Button]}" Click="AboutButton_Click">
                <ui:SymbolIcon Symbol="Info24"/>
            </Button>
            <Button x:Name="OverlayStatusButton" DockPanel.Dock="Right" Width="250" Height="28" Margin="0,0,16,0" Click="OverlayStatusButton_Click"
                    HorizontalContentAlignment="Left">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="OverlayStatusIndicator" Width="12" Height="12" Fill="Gray" Margin="4,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OverlayStatusButtonText" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Overlay.Status.Stopped]}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button.Content>
            </Button>
            <TextBlock Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panels.Header]}" VerticalAlignment="Center" FontWeight="Bold"/>
        </DockPanel>

                <!-- openXR Status block -->
                <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,10,10,10" TextWrapping="Wrap" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Status.Ready]}"/>

                <!-- Panel list. The row has a fixed height (see RowDefinitions
             above) so the section neither collapses to nothing nor grows
             unpredictably (e.g. an Auto-sized row hosting a ScrollViewer
             can mis-measure on the first layout pass and re-expand once
             the user interacts with/scrolls it); panels beyond that height
             simply scroll. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="PanelsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:OverlayPanel}">
                        <Border BorderThickness="2" CornerRadius="4" Margin="0,0,0,8" Padding="8">
                            <Border.BorderBrush>
                                <MultiBinding Converter="{StaticResource ActivePanelBorderBrushConverter}">
                                    <Binding Path="."/>
                                    <Binding ElementName="ActiveNudgePanelComboBox" Path="SelectedItem"/>
                                    <Binding Path="IsLocked"/>
                                </MultiBinding>
                            </Border.BorderBrush>
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Remove]}" Click="RemovePanelButton_Click" Tag="{Binding}"/>
                                    <CheckBox Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Lock]}" IsChecked="{Binding IsLocked}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <CheckBox Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Active]}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="140" Margin="0,0,12,0"/>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <RadioButton Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Source.Window]}" IsChecked="{Binding SourceType, Converter={StaticResource SourceTypeConverter}, ConverterParameter=WindowCapture}" GroupName="{Binding Id}" Margin="0,0,12,0"/>
                                    <RadioButton Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Source.WebDashboard]}" IsChecked="{Binding SourceType, Converter={StaticResource SourceTypeConverter}, ConverterParameter=WebDashboard}" GroupName="{Binding Id}" Margin="0,0,12,0"/>
                                    <RadioButton Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Source.TestPattern]}" IsChecked="{Binding SourceType, Converter={StaticResource SourceTypeConverter}, ConverterParameter=TestPattern}" GroupName="{Binding Id}" Margin="0,0,12,0"/>
                                    <RadioButton Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Source.Image]}" IsChecked="{Binding SourceType, Converter={StaticResource SourceTypeConverter}, ConverterParameter=Image}" GroupName="{Binding Id}" Margin="0,0,12,0"/>
                                    <RadioButton Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Source.Visor]}" IsChecked="{Binding SourceType, Converter={StaticResource SourceTypeConverter}, ConverterParameter=Visor}" GroupName="{Binding Id}"/>
                                </StackPanel>

                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding DataContext.AvailableWindows, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Title" SelectedValuePath="Handle" SelectedValue="{Binding WindowHandle}"
                                              Visibility="{Binding SourceType, Converter={StaticResource SourceTypeVisibilityConverter}, ConverterParameter=WindowCapture}"/>
                                    <ComboBox Grid.Column="0" IsEditable="True" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.SimHubDashboards, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name" TextSearch.TextPath="Url"
                                              DropDownOpened="SimHubDashboardComboBox_DropDownOpened"
                                              Visibility="{Binding SourceType, Converter={StaticResource SourceTypeVisibilityConverter}, ConverterParameter=WebDashboard}"/>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                Visibility="{Binding SourceType, Converter={StaticResource SourceTypeVisibilityConverter}, ConverterParameter=Image}">
                                        <TextBox Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}" Width="260" IsReadOnly="True" Margin="0,0,8,0"/>
                                        <Button Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Browse]}" Click="BrowseImageButton_Click" Tag="{Binding}"/>
                                    </StackPanel>
									<StackPanel Grid.Column="0" Orientation="Vertical" Grid.IsSharedSizeScope="True"
												Visibility="{Binding SourceType, Converter={StaticResource SourceTypeVisibilityConverter}, ConverterParameter=Visor}">
										<!-- Helmet library -->
										<StackPanel Orientation="Horizontal" Margin="0,0,0,8">
											<TextBlock Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Helmet.Library]}" VerticalAlignment="Center" Margin="0,0,6,0"/>
											<ComboBox Width="200" IsEditable="True" Margin="0,0,6,0"
													  ItemsSource="{Binding DataContext.HelmetLibrary, RelativeSource={RelativeSource AncestorType=Window}}"
													  ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.Library]}"/>
											<Button Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Helmet.Load]}" Click="HelmetLoadButton_Click" Tag="{Binding}" Margin="0,0,4,0"/>
											<Button Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Helmet.Save]}" Click="HelmetSaveButton_Click" Tag="{Binding}" Margin="0,0,4,0"/>
											<Button Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Helmet.Delete]}" Click="HelmetDeleteButton_Click" Tag="{Binding}"/>
										</StackPanel>

										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="12"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>

											<!-- Left column -->
											<StackPanel Grid.Column="0">
												<GroupBox Header="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Group.Glass]}" Padding="6" Margin="0,0,0,8">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" SharedSizeGroup="VisorLabel"/>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="46"/>
														</Grid.ColumnDefinitions>
														<Grid.RowDefinitions>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
														</Grid.RowDefinitions>
														<TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.End]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
															<Border Width="22" Height="22" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,4,0"
																	Background="{Binding VisorEndColor, Converter={StaticResource HexColorToBrushConverter}}"
																	ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TintColor]}"/>
															<Button Content="…" Width="32" Click="PickVisorColorButton_Click" Tag="{Binding}" CommandParameter="End"
																	ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TintColor]}"/>
														</StackPanel>
														<TextBlock Grid.Row="1" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Opacity]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="1" Grid.Column="1" Value="{Binding VisorEndOpacity}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TintColor]}"/>
														<TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VisorEndOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
													</Grid>
												</GroupBox>

												<GroupBox Header="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Group.Strip]}" Padding="6" Margin="0,0,0,8">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" SharedSizeGroup="VisorLabel"/>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="46"/>
														</Grid.ColumnDefinitions>
														<Grid.RowDefinitions>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
														</Grid.RowDefinitions>
														<TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Color]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
															<Border Width="22" Height="22" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,4,0"
																	Background="{Binding VisorColor, Converter={StaticResource HexColorToBrushConverter}}"
																	ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.SunColor]}"/>
															<Button Content="…" Width="32" Click="PickVisorColorButton_Click" Tag="{Binding}" CommandParameter="Start"
																	ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.SunColor]}"/>
														</StackPanel>
														<TextBlock Grid.Row="1" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Opacity]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="1" Grid.Column="1" Value="{Binding VisorOpacity}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.SunColor]}"/>
														<TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VisorOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
														<TextBlock Grid.Row="2" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Height]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="2" Grid.Column="1" Value="{Binding VisorCoverage}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.StripHeight]}"/>
														<TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding VisorCoverage, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
														<TextBlock Grid.Row="3" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Curve]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="3" Grid.Column="1" Value="{Binding VisorCurve}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.StripCurve]}"/>
														<TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding VisorCurve, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
													</Grid>
												</GroupBox>

												<GroupBox Header="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Group.Wear]}" Padding="6" Margin="0,0,0,8">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" SharedSizeGroup="VisorLabel"/>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="46"/>
														</Grid.ColumnDefinitions>
														<Grid.RowDefinitions>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
														</Grid.RowDefinitions>
														<TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Scratches]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="0" Grid.Column="1" Value="{Binding VisorScratches}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.Scratches]}"/>
														<TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding VisorScratches, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
														<TextBlock Grid.Row="1" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Dirt]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="1" Grid.Column="1" Value="{Binding VisorDirt}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.Dirt]}"/>
														<TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VisorDirt, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
														<TextBlock Grid.Row="2" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Bubbles]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="2" Grid.Column="1" Value="{Binding VisorBubbles}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.Bubbles]}"/>
														<TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding VisorBubbles, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
														<Button Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" Margin="0,4,0,0"
																Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.NewSeed]}" Click="NewVisorSeedButton_Click" Tag="{Binding}"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.NewSeedTooltip]}"/>
													</Grid>
												</GroupBox>
											</StackPanel>

											<!-- Right column -->
											<StackPanel Grid.Column="2">
												<GroupBox Header="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Group.Fit]}" Padding="6" Margin="0,0,0,8">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" SharedSizeGroup="VisorLabel"/>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="46"/>
														</Grid.ColumnDefinitions>
														<Grid.RowDefinitions>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
														</Grid.RowDefinitions>
														<TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.SizeOnly]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="0" Grid.Column="1" Value="{Binding VisorSize}" Minimum="0.3" Maximum="3" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.Size]}"/>
														<TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding VisorSize, StringFormat={}{0:0.00}×}" VerticalAlignment="Center" TextAlignment="Right"/>
														<TextBlock Grid.Row="1" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.OffsetX]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="1" Grid.Column="1" Value="{Binding VisorOffsetX}" Minimum="-0.3" Maximum="0.3" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.OffsetX]}"/>
														<TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VisorOffsetX, StringFormat={}{0:0.00} m}" VerticalAlignment="Center" TextAlignment="Right"/>
														<TextBlock Grid.Row="2" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.OffsetY]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="2" Grid.Column="1" Value="{Binding VisorOffsetY}" Minimum="-0.3" Maximum="0.3" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.OffsetY]}"/>
														<TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding VisorOffsetY, StringFormat={}{0:0.00} m}" VerticalAlignment="Center" TextAlignment="Right"/>
														<TextBlock Grid.Row="3" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.OffsetZ]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="3" Grid.Column="1" Value="{Binding VisorOffsetZ}" Minimum="-0.3" Maximum="0.3" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.OffsetZ]}"/>
														<TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding VisorOffsetZ, StringFormat={}{0:0.00} m}" VerticalAlignment="Center" TextAlignment="Right"/>
													</Grid>
												</GroupBox>

												<GroupBox Header="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Group.Open]}" Padding="6" Margin="0,0,0,8">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" SharedSizeGroup="VisorLabel"/>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="46"/>
														</Grid.ColumnDefinitions>
														<Grid.RowDefinitions>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
														</Grid.RowDefinitions>
														<TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.OpenAngle]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="0" Grid.Column="1" Value="{Binding VisorOpenAngle}" Minimum="10" Maximum="120" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.OpenAngle]}"/>
														<TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding VisorOpenAngle, StringFormat={}{0:0}°}" VerticalAlignment="Center" TextAlignment="Right"/>
														<TextBlock Grid.Row="1" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.EdgeCurve]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="1" Grid.Column="1" Value="{Binding VisorEdgeCurve}" Minimum="0" Maximum="1.5" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.EdgeCurve]}"/>
														<TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VisorEdgeCurve, StringFormat={}{0:0.00}}" VerticalAlignment="Center" TextAlignment="Right"/>
													</Grid>
												</GroupBox>

												<GroupBox Header="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Group.Text]}" Padding="6" Margin="0,0,0,8">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" SharedSizeGroup="VisorLabel"/>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="46"/>
														</Grid.ColumnDefinitions>
														<Grid.RowDefinitions>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
															<RowDefinition Height="Auto"/>
														</Grid.RowDefinitions>
														<TextBlock Grid.Row="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Text]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2">
															<TextBox Text="{Binding VisorText, UpdateSourceTrigger=PropertyChanged}" Width="150" MaxLength="63" VerticalAlignment="Center" Margin="0,0,6,0"
																	 ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.Text]}"/>
															<Border Width="22" Height="22" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,4,0"
																	Background="{Binding VisorTextColor, Converter={StaticResource HexColorToBrushConverter}}"
																	ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TextColor]}"/>
															<Button Content="…" Width="32" Click="PickVisorColorButton_Click" Tag="{Binding}" CommandParameter="Text"
																	ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TextColor]}"/>
														</StackPanel>
														<TextBlock Grid.Row="1" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.TextFont]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{x:Static Fonts.SystemFontFamilies}" Text="{Binding VisorTextFont, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,2"
																  ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TextFont]}"/>
														<StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2">
															<CheckBox Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.TextBold]}" IsChecked="{Binding VisorTextBold}" Margin="0,0,12,0"
																	  ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TextBold]}"/>
															<CheckBox Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.TextItalic]}" IsChecked="{Binding VisorTextItalic}"
																	  ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TextItalic]}"/>
														</StackPanel>
														<TextBlock Grid.Row="3" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Opacity]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="3" Grid.Column="1" Value="{Binding VisorTextOpacity}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TextOpacity]}"/>
														<TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding VisorTextOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
														<TextBlock Grid.Row="4" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.TextSize]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="4" Grid.Column="1" Value="{Binding VisorTextSize}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TextSize]}"/>
														<TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding VisorTextSize, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
														<TextBlock Grid.Row="5" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.TextBlur]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
														<Slider Grid.Row="5" Grid.Column="1" Value="{Binding VisorTextBlur}" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,2"
																ToolTip="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Tip.TextBlur]}"/>
														<TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding VisorTextBlur, StringFormat={}{0:P0}}" VerticalAlignment="Center" TextAlignment="Right"/>
													</Grid>
												</GroupBox>
											</StackPanel>
										</Grid>

										<TextBlock Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Visor.Hint]}" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0"/>
									</StackPanel>
                                </Grid>

                                <Grid Margin="0,8,0,0" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBooleanConverter}}" Visibility="{Binding SourceType, Converter={StaticResource SourceTypeVisibilityConverter}, ConverterParameter=!Visor}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="31"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Position.X]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <RepeatButton Grid.Column="1" Content="−" Width="28" Click="NudgeStepButton_Click" Tag="PositionX,-0.005" Margin="0,0,2,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding PositionX, StringFormat={}{0:0.000}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,2,0"/>
                                    <RepeatButton Grid.Column="3" Content="+" Width="28" Click="NudgeStepButton_Click" Tag="PositionX,0.005"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Position.Y]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <RepeatButton Grid.Column="6" Content="−" Width="28" Click="NudgeStepButton_Click" Tag="PositionY,-0.005" Margin="0,0,2,0"/>
                                    <TextBox Grid.Column="7" Text="{Binding PositionY, StringFormat={}{0:0.000}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,2,0"/>
                                    <RepeatButton Grid.Column="8" Content="+" Width="28" Click="NudgeStepButton_Click" Tag="PositionY,0.005"/>
                                    <TextBlock Grid.Column="10" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Position.Z]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <RepeatButton Grid.Column="11" Content="−" Width="28" Click="NudgeStepButton_Click" Tag="PositionZ,-0.005" Margin="0,0,2,0"/>
                                    <TextBox Grid.Column="12" Text="{Binding PositionZ, StringFormat={}{0:0.000}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,2,0"/>
                                    <RepeatButton Grid.Column="13" Content="+" Width="28" Click="NudgeStepButton_Click" Tag="PositionZ,0.005"/>
                                </Grid>

                                <Grid Margin="0,4,0,0" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBooleanConverter}}" Visibility="{Binding SourceType, Converter={StaticResource SourceTypeVisibilityConverter}, ConverterParameter=!Visor}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="31"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Rotation.Pitch]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <RepeatButton Grid.Column="1" Content="−" Width="28" Click="NudgeStepButton_Click" Tag="PitchDeg,-0.5" Margin="0,0,2,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding PitchDeg, StringFormat={}{0:0.0}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,2,0"/>
                                    <RepeatButton Grid.Column="3" Content="+" Width="28" Click="NudgeStepButton_Click" Tag="PitchDeg,0.5"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Rotation.Yaw]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <RepeatButton Grid.Column="6" Content="−" Width="28" Click="NudgeStepButton_Click" Tag="YawDeg,-0.5" Margin="0,0,2,0"/>
                                    <TextBox Grid.Column="7" Text="{Binding YawDeg, StringFormat={}{0:0.0}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,2,0"/>
                                    <RepeatButton Grid.Column="8" Content="+" Width="28" Click="NudgeStepButton_Click" Tag="YawDeg,0.5"/>
                                    <TextBlock Grid.Column="10" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Rotation.Roll]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <RepeatButton Grid.Column="11" Content="−" Width="28" Click="NudgeStepButton_Click" Tag="RollDeg,-0.5" Margin="0,0,2,0"/>
                                    <TextBox Grid.Column="12" Text="{Binding RollDeg, StringFormat={}{0:0.0}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,2,0"/>
                                    <RepeatButton Grid.Column="13" Content="+" Width="28" Click="NudgeStepButton_Click" Tag="RollDeg,0.5"/>
                                </Grid>

                                <Grid Margin="0,4,0,0" IsEnabled="{Binding IsLocked, Converter={StaticResource InverseBooleanConverter}}" Visibility="{Binding SourceType, Converter={StaticResource SourceTypeVisibilityConverter}, ConverterParameter=!Visor}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.Scale]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <RepeatButton Grid.Column="1" Content="−" Width="28" Click="NudgeStepButton_Click" Tag="Scale,-0.01" Margin="0,0,2,0"/>
                                    <TextBox Grid.Column="2" Text="{Binding Scale, StringFormat={}{0:0.000}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" TextAlignment="Center" Margin="0,0,2,0"/>
                                    <RepeatButton Grid.Column="3" Content="+" Width="28" Click="NudgeStepButton_Click" Tag="Scale,0.01"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.SizeMeters]}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="6" Text="{Binding WidthMeters, StringFormat={}{0:0.00}}" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                    <TextBlock Grid.Column="7" Text="{Binding HeightMeters, StringFormat={}× {0:0.00}}" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.HeadLocked]}" Visibility="{Binding SourceType, Converter={StaticResource SourceTypeVisibilityConverter}, ConverterParameter=!Visor}" IsChecked="{Binding HeadLocked}" Margin="0,0,16,0"/>
                                    <CheckBox Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Panel.OpaqueBackground]}" IsChecked="{Binding OpaqueBackground}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
            </Grid>
        </Border>

        <!-- Edit-mode HUD: shown while the keyboard edit mode is active,
             overlaid in the corner of the window so the user can see the
             active panel, current mode/speed and the values being edited
             without needing to look at the panel list. -->
        <Border x:Name="EditModeHudBorder" Grid.Row="5" Grid.RowSpan="9" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#CC202020" BorderBrush="Orange" BorderThickness="2" CornerRadius="6"
                Padding="12" Margin="0,0,8,8">
            <StackPanel MinWidth="260">
                <TextBlock x:Name="EditModeHudTitleText" Text="Edit Mode" FontWeight="Bold" FontSize="14" Foreground="Orange" Margin="0,0,0,6"/>
                <TextBlock Foreground="White">
                    <Run x:Name="EditModeHudPanelLabelText" Text="Panel: "/>
                    <Run x:Name="EditModeHudPanelNameText" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Foreground="White">
                    <Run x:Name="EditModeHudModeLabelText" Text="Modus: "/>
                    <Run x:Name="EditModeHudModeText" Text="Verschieben" FontWeight="Bold"/>
                    <Run x:Name="EditModeHudSpeedLabelText" Text="   Geschwindigkeit: "/>
                    <Run x:Name="EditModeHudSpeedText" Text="normal" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock x:Name="EditModeHudValuesText" Foreground="White" Margin="0,4,0,8" TextWrapping="Wrap"/>
                <TextBlock Foreground="LightGray" TextWrapping="Wrap" FontSize="11">
                    <Run x:Name="EditModeHudLegendMoveText" Text="W/A/S/D: forward/back · left/right"/><LineBreak/>
                    <Run x:Name="EditModeHudLegendRollText" Text="Q/E: runter/hoch bzw. Rollen"/><LineBreak/>
                    <Run x:Name="EditModeHudLegendTabText" Text="Tab: Verschieben ⟷ Ausrichten"/><LineBreak/>
                    <Run x:Name="EditModeHudLegendSwitchText" Text="C: switch panel (Shift+C backwards)"/><LineBreak/>
                    <Run x:Name="EditModeHudLegendLockText" Text="L: Panel sperren/entsperren"/><LineBreak/>
                    <Run x:Name="EditModeHudLegendSpeedKeysText" Text="Shift: fein · Alt: grob"/><LineBreak/>
                    <Run x:Name="EditModeHudLegendEscText" Text="Esc: exit edit mode"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Global settings: controller fine-tuning, VR reset button
             binding and OpenXR API layer registration. These are one-off/
             rarely-changed setup steps, so they're tucked away in a
             collapsed Expander to keep the main window focused on the
             panels/profiles that are used day to day. -->
        <Popup x:Name="GlobalSettingsPopup" PlacementTarget="{Binding ElementName=SettingsToggleButton}" Placement="Right"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="8" Margin="8,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700" MaxWidth="480">
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Header]}" FontWeight="Bold" Margin="0,0,0,8"/>
                    <!-- VR Reset button binding -->
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel>

                            <TextBlock Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.VrReset.Header]}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ResetBindingsItemsControl" ItemsSource="{Binding ResetBindingRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ResetBindingRow}">
                                        <DockPanel Margin="0,2,0,2">
                                            <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Nudge.Clear]}" Width="80" Margin="4,0,0,0" Click="RemoveResetBindingButton_Click" Tag="{Binding}"/>
                                            <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ResetBindingStatusText" VerticalAlignment="Center" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.VrReset.NoButton]}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LearnResetButton" Grid.Column="0" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.VrReset.Learn]}" Click="LearnResetButton_Click" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                                <Button x:Name="ManualResetButton" Grid.Column="1" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.VrReset.ManualReset]}" Click="ManualResetButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Helmet visor open/close button binding -->
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.VisorToggle.Header]}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding VisorToggleBindingRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:ResetBindingRow}">
                                        <DockPanel Margin="0,2,0,2">
                                            <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Nudge.Clear]}" Width="80" Margin="4,0,0,0" Click="RemoveVisorToggleBindingButton_Click" Tag="{Binding}"/>
                                            <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="VisorToggleBindingStatusText" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LearnVisorToggleButton" Grid.Column="0" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.VrReset.Learn]}" Click="LearnVisorToggleButton_Click" Margin="0,0,8,0" HorizontalAlignment="Left"/>
                                <Button Grid.Column="1" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.VisorToggle.Manual]}" Click="ManualVisorToggleButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- VR-capable fine-tuning: change position/orientation of the active,
                     unlocked panel via controller buttons, without having to look at the
                     desktop UI. -->
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Nudge.Header]}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Nudge.ActivePanel]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="ActiveNudgePanelComboBox" Grid.Column="1" ItemsSource="{Binding Panels}" DisplayMemberPath="Name" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Nudge.StepSize]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="NudgeStepSizeText" Grid.Column="3" VerticalAlignment="Center" Text="fine"/>
                            </Grid>
                            <ItemsControl x:Name="NudgeBindingsItemsControl" ItemsSource="{Binding NudgeActionRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:NudgeActionRow}">
                                        <DockPanel Margin="0,2,0,2">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="140" VerticalAlignment="Center"/>
                                            <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Nudge.Clear]}" Width="80" Margin="4,0,0,0" Click="ClearNudgeBindingButton_Click" Tag="{Binding Action}"/>
                                            <Button DockPanel.Dock="Right" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Nudge.Assign]}" Width="90" Click="LearnNudgeBindingButton_Click" Tag="{Binding Action}"/>
                                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NudgeStatusText" Margin="0,8,0,0" TextWrapping="Wrap" Text=""/>
                        </StackPanel>
                    </Border>

                    <!-- OpenXR API layer registration (required so overlays render inside
                     the host application's own OpenXR session, e.g. iRacing, instead
                     of a separate session) -->
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Layer.Header]}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LayerStatusText" Grid.Column="0" VerticalAlignment="Center" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Layer.CheckingStatus]}" Margin="0,0,8,0" TextWrapping="Wrap"/>
                                <Button x:Name="RegisterLayerButton" Grid.Column="1" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Layer.Register]}" Click="RegisterLayerButton_Click" Margin="0,0,8,0"/>
                                <Button x:Name="UnregisterLayerButton" Grid.Column="2" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.Layer.Unregister]}" Click="UnregisterLayerButton_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- General app behavior settings. -->
                    <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static local:Localization.Instance}, Path=[Global.General.Header]}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CloseToTrayCheckBox" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[App.CloseToTray]}" Checked="CloseToTrayCheckBox_Changed" Unchecked="CloseToTrayCheckBox_Changed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>


        

        <!-- Live view of the native layer's diagnostic log
             (%TEMP%\DonutzVrHudLayer.log), so we can see directly in the app
             whether iRacing ever loaded/negotiated the native OpenXR API
             layer, without having to open the file manually. Collapsed by
             default to save space. -->
        <Popup x:Name="NativeLogPopup" PlacementTarget="{Binding ElementName=NativeLogToggleButton}" Placement="Right"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="8" Margin="8,0,0,0">
                <DockPanel Margin="0,0,0,0" Width="480">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Source={x:Static local:Localization.Instance}, Path=[NativeLog.Header]}" FontWeight="Bold" Margin="0,0,0,8"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" x:Name="RefreshNativeLogButton" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[NativeLog.Refresh]}" Click="RefreshNativeLogButton_Click"/>
                        <CheckBox x:Name="VerboseLoggingCheckBox" Content="{Binding Source={x:Static local:Localization.Instance}, Path=[NativeLog.VerboseLogging]}" VerticalAlignment="Center"
                                  Checked="VerboseLoggingCheckBox_Changed" Unchecked="VerboseLoggingCheckBox_Changed"/>
                    </DockPanel>
                    <TextBox x:Name="NativeLogTextBox" DockPanel.Dock="Bottom" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                             Height="120"
                             Text="{Binding Source={x:Static local:Localization.Instance}, Path=[NativeLog.NoFileFound], Mode=OneWay}"/>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
